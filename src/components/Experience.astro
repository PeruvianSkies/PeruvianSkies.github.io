---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import SectionWatermark from './SectionWatermark.astro';

interface Props {
  lang: Lang;
  title: string;
  experiences: {
    company: { name: string; url: string; location: string };
    positions: {
      designation: string;
      start: string;
      end?: string | null;
      responsibilities: string[];
      achievements?: string[];
    }[];
  }[];
}

const { lang, title, experiences } = Astro.props;
const t = useTranslations(lang);

const entries = experiences.flatMap((exp) => exp.positions.map((position) => ({ company: exp.company, position })));
---

<section id="experiences" class="relative mx-auto max-w-[100rem] overflow-hidden px-6 py-16 sm:py-20">
  <SectionWatermark text="Journey" />

  <div class="relative mt-20 border-t border-panel-border" />

  <ol class="relative mx-auto mt-10 max-w-2xl space-y-6">
    {
      entries.map(({ company, position }) => (
        <li class="relative">
          <div
            class={`rounded-2xl border border-l-4 bg-panel p-5 shadow-sm ${
              position.end ? 'border-panel-border border-l-term-dim/30' : 'border-panel-border border-l-prompt'
            }`}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-bold">{position.designation}</h3>
              <span class="text-xs font-medium text-term-dim">
                {position.start} — {position.end || 'Present'}
              </span>
            </div>

            <p class="text-sm text-term-dim">
              {company.url ? (
                <a href={company.url} target="_blank" rel="noopener noreferrer" class="hover:text-prompt">
                  {company.name}
                </a>
              ) : (
                company.name
              )}
              {company.location && (
                <>
                  {' · '}
                  {company.location}
                </>
              )}
            </p>

            <ul class="mt-3 space-y-1.5 text-sm text-term-dim">
              {position.responsibilities.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-term-dim" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            {position.achievements && position.achievements.length > 0 && (
              <div class="mt-4">
                <p class="text-xs font-bold tracking-wide text-prompt uppercase">{t('experience.keyAchievements')}</p>
                <ul class="mt-2 space-y-1.5 text-sm text-term-dim">
                  {position.achievements.map((item) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-prompt" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
