---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import SocialIcon from './SocialIcon.astro';

interface Props {
  lang: Lang;
  copyright: string;
  email: string;
  socialLinks: { name: string; icon: string; url: string }[];
}

const { lang, copyright, email, socialLinks } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-panel-border bg-gradient-to-b from-accent-500/5 to-bg">
  <div class="bg-ambient absolute inset-0"></div>

  <div class="relative mx-auto max-w-2xl px-6 py-20 text-center">
    <h2 class="text-3xl font-black tracking-tight sm:text-4xl">{t('about.contactMe')}</h2>

    <a
      href={`mailto:${email}`}
      class="mt-6 inline-block rounded-md bg-prompt px-7 py-3 font-mono text-sm font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
    >
      {t('footer.cta')} →
    </a>

    <div class="mt-8 flex items-center justify-center gap-3">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.name}
            class="grid h-10 w-10 place-items-center rounded-full border border-panel-border text-term-dim transition-colors hover:border-prompt hover:text-prompt"
          >
            <SocialIcon name={link.name} class="h-4 w-4" />
          </a>
        ))
      }
    </div>
  </div>

  <div class="relative border-t border-panel-border px-6 py-5 text-center text-xs text-term-dim">
    © {year} {copyright}
  </div>
</footer>
