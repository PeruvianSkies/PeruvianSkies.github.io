---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['overflow-hidden rounded-lg border border-panel-border bg-panel shadow-sm', className]}>
  <div class="flex items-center gap-2 border-b border-panel-border px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
    <span class="ml-2 truncate text-xs text-term-dim">{title}</span>
  </div>

  <div class="p-5 sm:p-6">
    <slot />
  </div>
</div>
