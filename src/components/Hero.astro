---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { authorPhotos } from '../lib/images';
import SocialIcon from './SocialIcon.astro';
import TerminalWindow from './TerminalWindow.astro';

interface Props {
  lang: Lang;
  greeting: string;
  name: string;
  photo: string;
  designation: string;
  company: { name: string; url: string };
  summary: string;
  resume: string;
  socialLinks: { name: string; icon: string; url: string }[];
  softSkills: { name: string; percentage: number; color: string }[];
}

const { lang, greeting, name, photo, designation, company, summary, resume, socialLinks, softSkills } = Astro.props;
const t = useTranslations(lang);

const photoImage = authorPhotos.get(photo);

const barColor: Record<string, string> = {
  blue: 'bg-blue-500',
  yellow: 'bg-yellow-500',
  green: 'bg-emerald-500',
  orange: 'bg-orange-500',
  sky: 'bg-sky-500',
  pink: 'bg-pink-500'
};
---

<section id="about" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 sm:py-20">
  <TerminalWindow title="tian@site:~">
    <div class="space-y-8 text-sm sm:text-base">
      <div>
        <p class="text-term-dim"><span class="text-prompt">$</span> neofetch</p>
        <div class="mt-3 flex items-start gap-5">
          {
            photoImage && (
              <Image
                src={photoImage}
                alt={name}
                width={112}
                height={112}
                loading="eager"
                fetchpriority="high"
                class="h-20 w-20 shrink-0 rounded-md object-cover ring-2 ring-prompt/30 sm:h-28 sm:w-28"
              />
            )
          }
          <div>
            <p class="text-prompt">{greeting}</p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">{name}</h1>
            <p class="mt-1 text-term-dim">
              {designation} @{' '}
              {company.url ? (
                <a href={company.url} target="_blank" rel="noopener noreferrer" class="hover:text-prompt">
                  {company.name}
                </a>
              ) : (
                company.name
              )}
            </p>
          </div>
        </div>
      </div>

      <div>
        <p class="text-term-dim"><span class="text-prompt">$</span> cat about.txt</p>
        <p class="mt-2 max-w-2xl text-term-dim">{summary}</p>
      </div>

      <div>
        <p class="text-term-dim"><span class="text-prompt">$</span> ls socials/</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.name}
                class="grid h-9 w-9 place-items-center rounded-md border border-panel-border text-term-dim transition-colors hover:border-prompt hover:text-prompt"
              >
                <SocialIcon name={link.name} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-term-dim"><span class="text-prompt">$</span> ./resume.sh --download</p>
        <a
          href={resume}
          download
          class="mt-2 inline-block rounded-md bg-prompt px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-85"
        >
          {t('about.downloadResume')}
        </a>
      </div>

      <div>
        <p class="text-term-dim"><span class="text-prompt">$</span> cat soft-skills.log</p>
        <div class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            softSkills.map((skill) => (
              <div>
                <div class="mb-1 flex justify-between text-xs">
                  <span class="text-term-dim"># {skill.name}</span>
                  <span class="text-term-dim">{skill.percentage}%</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-panel-border">
                  <div class={`h-full rounded-full ${barColor[skill.color] ?? 'bg-prompt'}`} style={`width: ${skill.percentage}%`} />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="text-term-dim"><span class="text-prompt">$</span> <span class="cursor-blink">▍</span></p>
    </div>
  </TerminalWindow>
</section>
