---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const authorEntry = await getEntry('author', lang);
const aboutEntry = await getEntry('about', lang);
const skillsEntry = await getEntry('skills', lang);
const experiencesEntry = await getEntry('experiences', lang);
const projectsEntry = await getEntry('projects', lang);
const siteEntry = await getEntry('site', lang);

if (!authorEntry || !aboutEntry || !skillsEntry || !experiencesEntry || !projectsEntry || !siteEntry) {
  throw new Error(`Missing content entry for locale "${lang}"`);
}

const author = authorEntry.data;
const about = aboutEntry.data;
const skills = skillsEntry.data;
const experiences = experiencesEntry.data;
const projects = projectsEntry.data;
const site = siteEntry.data;

const pageTitle = `${author.name} — ${about.designation}`;

const stats = {
  yearsExperience: '5+',
  projectsCount: projects.projects.length,
  companiesCount: experiences.experiences.length,
  skillsCount: skills.categories.reduce((total, category) => total + category.skills.length, 0)
};
---

<Layout lang={lang} title={pageTitle} description={site.description}>
  <Header lang={lang} />

  <main>
    <Hero
      lang={lang}
      greeting={author.greeting}
      name={author.name}
      photo={author.image}
      designation={about.designation}
      company={about.company}
      summary={about.summary}
      resume={about.resume}
      socialLinks={about.socialLinks}
    />

    <Skills lang={lang} categories={skills.categories} softSkills={about.softSkills} stats={stats} />

    <Experience lang={lang} title={experiences.section.name} experiences={experiences.experiences} />

    <Projects lang={lang} title={projects.section.name} buttons={projects.buttons} projects={projects.projects} />
  </main>

  <Footer lang={lang} copyright={site.copyright} email={author.contactInfo.email} socialLinks={about.socialLinks} />
</Layout>
