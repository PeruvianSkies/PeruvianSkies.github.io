---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { skillIcons } from '../lib/images';

interface Props {
  lang: Lang;
  title: string;
  skills: { name: string; icon: string; summary: string; url: string }[];
}

const { title, skills } = Astro.props;
---

<section id="skills" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 sm:py-20">
  <p class="text-sm text-term-dim sm:text-base"><span class="text-prompt">$</span> cat skills.yaml</p>
  <h2 class="mt-1 text-term-dim"># {title}</h2>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((skill) => {
        const icon = skillIcons.get(skill.icon);
        return (
          <a
            href={skill.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-lg border border-panel-border bg-panel p-5 transition-colors hover:border-prompt"
          >
            <div class="flex items-center gap-3">
              {icon && <Image src={icon} alt={skill.name} width={32} height={32} class="h-8 w-8 rounded object-contain" />}
              <h3 class="font-semibold group-hover:text-prompt">
                <span class="text-term-dim">$</span> {skill.name}
              </h3>
            </div>
            <p class="mt-3 text-sm text-term-dim">{skill.summary}</p>
          </a>
        );
      })
    }
  </div>
</section>
