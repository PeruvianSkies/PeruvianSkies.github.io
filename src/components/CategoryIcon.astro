---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

// Generic per-category fallback icons for skills that don't have a bundled brand logo
// (src/assets/images/skills/) -- keeps every card visually consistent without sourcing
// individual third-party logos or depending on an external icon CDN.
const paths: Record<string, string> = {
  cloud: 'M6.5 19a4.5 4.5 0 0 1-.4-8.98A6 6 0 0 1 17.9 8.06 4.5 4.5 0 0 1 17.5 19h-11Z',
  containers:
    'M12 2 3 6.5v11L12 22l9-4.5v-11L12 2Zm0 2.24 6.7 3.35L12 10.94l-6.7-3.35L12 4.24ZM5 9.3l6 3v7.15l-6-3V9.3Zm14 0v7.15l-6 3V12.3l6-3Z',
  cicd: 'M17.5 6.5a3.5 3.5 0 1 0-3.24-4.83L9 5.5l1.24 1.65 5.03-3.78a1.5 1.5 0 1 1 .9 2.4L7 10.13a3.5 3.5 0 1 0 1.24 1.65l9.26-4.16a3.5 3.5 0 0 0 0-1.12ZM6.5 15.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm11 4a3.5 3.5 0 0 0-3.31 2.35l-4.95-2.6-.93 1.77 4.95 2.6a3.5 3.5 0 1 0 4.24-4.12Z',
  security:
    'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm0 2.18 6 2.25V11c0 4-2.7 7.5-6 8.86C8.7 18.5 6 15 6 11V6.43l6-2.25Zm-1 6.32v3h2v-3h-2Zm0 4v2h2v-2h-2Z',
  finops:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm.9 15.6v1.4h-1.8v-1.38c-1.35-.22-2.4-.98-2.85-2.16l1.55-.63c.28.72.95 1.2 1.9 1.2.8 0 1.4-.36 1.4-.98 0-.6-.5-.86-1.7-1.16-1.72-.42-2.85-1.03-2.85-2.5 0-1.2.9-2.05 2.25-2.28V7.4h1.8v1.35c1.15.22 1.95.9 2.3 1.87l-1.5.65c-.25-.6-.8-.98-1.55-.98-.7 0-1.2.32-1.2.86 0 .58.55.8 1.7 1.1 1.85.47 2.9 1.13 2.9 2.6 0 1.28-.95 2.16-2.35 2.4Z',
  observability:
    'M3 12h3l2.2-6 3.4 12L14 9l1.8 3H21',
  systems:
    'M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-6v2h3v2H7v-2h3v-2H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2v7h14V7H5Z',
  data: 'M12 2C7.58 2 4 3.79 4 6s3.58 4 8 4 8-1.79 8-4-3.58-4-8-4ZM4 8.5v4c0 2.21 3.58 4 8 4s8-1.79 8-4v-4c0 2.21-3.58 4-8 4s-8-1.79-8-4Zm0 6.5v4c0 2.21 3.58 4 8 4s8-1.79 8-4v-4c0 2.21-3.58 4-8 4s-8-1.79-8-4Z'
};

const key = name.toLowerCase();
const strokeIcons = new Set(['observability']);
---

{
  strokeIcons.has(key) ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d={paths[key]} />
    </svg>
  ) : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d={paths[key] ?? paths.systems} />
    </svg>
  )
}
